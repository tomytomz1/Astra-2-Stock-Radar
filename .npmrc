# React Native's bundler (Metro) resolves modules by walking node_modules and assumes a flat,
# hoisted tree. pnpm's default isolated layout does not give it one: metro and
# @expo/metro-config never get linked into app/node_modules, and the iOS/Android builds fail
# during bundling with "Cannot read properties of undefined (reading 'transformFile')" -- Metro
# failing to locate its own transformer.
#
# This is the documented requirement for Expo in a pnpm workspace, not a workaround for this
# repo. Removing it will break `eas build` while leaving typecheck and unit tests green, so the
# failure surfaces 15 minutes into a remote build rather than locally.
node-linker=hoisted
