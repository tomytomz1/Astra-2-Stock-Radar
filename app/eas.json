{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_WORKER_URL": "https://REPLACE-WITH-YOUR-WORKER.workers.dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_WORKER_URL": "https://REPLACE-WITH-YOUR-WORKER.workers.dev"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_WORKER_URL": "https://REPLACE-WITH-YOUR-WORKER.workers.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
