{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_WORKER_URL": "https://REPLACE-WITH-YOUR-WORKER.workers.dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_WORKER_URL": "https://REPLACE-WITH-YOUR-WORKER.workers.dev"
      }
    }
  },
  "submit": {
    "preview": {}
  }
}
