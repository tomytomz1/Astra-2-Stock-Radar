{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "jsx": "react-native",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["react"],
    "noEmit": true,
    "declaration": false,
    "allowJs": false
  },
  "include": ["App.tsx", "app.config.ts", "src/**/*.ts", "src/**/*.tsx"]
}
